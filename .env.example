# Mineblock Admin Dashboard — environment template
# Copy to .env and fill in real values. NEVER commit .env.
# Ask the operator for real credential values.

# ---- Core ----
NODE_ENV=development
PORT=3000
DATABASE_URL=postgresql://user:password@localhost:5432/mineblock_admin
CORS_ORIGIN=http://localhost:5173
LOG_LEVEL=info

# ---- Auth ----
JWT_SECRET=your-jwt-secret-here
JWT_REFRESH_SECRET=your-refresh-secret-here

# ---- Initial admin (seed) ----
SUPERADMIN_EMAIL=admin@example.com
SUPERADMIN_PASSWORD=change-me

# ---- AI providers ----
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
NANOBANANA_API_KEY=

# ---- ClickUp ----
CLICKUP_API_TOKEN=

# ---- Triple Whale (analytics) ----
TRIPLEWHALE_API_KEY=
TRIPLEWHALE_SHOP_ID=

# ---- Meta / Facebook Ads ----
META_ACCESS_TOKEN=
META_AD_ACCOUNT_IDS=
META_WEBHOOK_VERIFY_TOKEN=

# ---- Slack ----
SLACK_BOT_TOKEN=
SLACK_REJECTION_CHANNEL=

# ---- Shopify ----
SHOPIFY_ACCESS_TOKEN=
SHOPIFY_STORE_DOMAIN=
SHOPIFY_WEBHOOK_SECRET=

# ---- Whop ----
WHOP_API_TOKEN=

# ---- Hub SSO (S1-4; dark unless HUB_SSO_ENABLED is exactly '1') ----
HUB_SSO_ENABLED=0
# Per store, set by the hub. At least 32 bytes or the route refuses to serve (503).
HUB_SSO_SECRET=
STORE_CODE=
# The hub's own origin (scheme + host, no path). Required while HUB_SSO_ENABLED=1: an exchange POSTed
# from anywhere else is refused with 403. Comma-separate if the hub answers on more than one hostname.
HUB_ORIGIN=

# ---- The Store Brain (S4-SB) ----
# Per-pair service token for the CRM / pipelines. READ-ONLY: search, documents,
# insights and the playbook may be read with it; every write needs a dashboard
# session. Minimum 16 characters, generated per store, never shared between
# stores, no platform fallback. Unset ⇒ service calls answer 503, never "allow".
BRAIN_SERVICE_TOKEN=
# Optional: with OPENAI_API_KEY set AND pgvector on this database, search runs the
# vector path; otherwise it runs the tsvector keyword path. Both are supported.
OPENAI_API_KEY=

# ---- Cloudflare R2 (media + the Brain's raw-body archive) ----
# R2_BUCKET_NAME is REQUIRED for the Brain: with account + keys but no bucket the
# legacy fallback bucket is shared by every store, and identical bytes give an
# identical key, so one store's ingest would overwrite another's archived body.
# The Brain refuses to mirror without it, and prefixes every key stores/<STORE_CODE>/.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=
R2_PUBLIC_URL=

# ---- Misc ----
SUPPLIER_SHARE_TOKEN=
