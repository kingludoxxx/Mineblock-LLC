# server/config/env.MB.example — the NON-SECRET store-config env for the
# Mineblock dashboard (mineblock-dashboard) that reproduces TODAY's behaviour
# now that server/src carries no store literal (Lane F, plan S1-5).
# Every value here was a literal in server/src on hub/main edc1030 (file:line
# in docs/lanes/lane-f.md). Secrets are NOT here: FRAMEIO_TOKEN,
# SHOPIFY_ACCESS_TOKEN, META_ACCESS_TOKEN, SLACK_BOT_TOKEN etc. stay on Render.
# Read at request time (R7): change a value on Render, no restart needed.

STORE_CODE=MB

# Brand (was VITE_* at build time; now served by GET /api/v1/brand — keep the
# VITE_* keys too until the client's runtime read has soaked)
BRAND_NAME=Mineblock LLC
BRAND_SHORT_NAME=Mineblock
BRAND_LOGO_WHITE=/logo-white.png
BRAND_LOGO_SYMBOL=/logo-symbol-white.png
BRAND_LOGO_BLACK=/logo-black.svg
BRAND_EMAIL_DOMAIN=mineblock.com

# Shopify (was kpiSystem.js:260, shopifyWebhook.js:19, adLauncher.js:208-217, 11× '2024-01')
SHOPIFY_STORE_DOMAIN=17cca0-2.myshopify.com
SHOPIFY_STORE_URL=https://mineblock.co
SHOPIFY_API_VERSION=2024-01

# Whop (was kpiSystem.js:274)
WHOP_COMPANY_ID=biz_pkN7XmNrvouslh

# Triple Whale (was the `TRIPLEWHALE_SHOP_ID || '17cca0-2…'` default in 6 files)
TRIPLEWHALE_SHOP_ID=17cca0-2.myshopify.com

# Meta Graph (was v21.0 in 10 files, v22.0 in adsReporting.js, v23.0 in staticsGeneration.js:4592).
# One version for every call site; the newest of the three wins on sunset runway (REVIEW-LANE-F.md P1-2).
META_API_VERSION=v23.0
# Ad-account display names (was adsControlCenter.js:20-23; Luvora entries dropped, out of scope)
META_AD_ACCOUNTS_JSON=[{"id":"act_938489175321542","name":"Mineblock X8"},{"id":"act_1972517213693373","name":"Mineblock CC 4"},{"id":"act_1238893338181787","name":"Mineblock CC 5"},{"id":"act_25781501541499027","name":"Mineblock X6"}]

# Slack channels (was kpiSystem.js:114/232/2785 + adsControlCenter.js:17 / kpiSystem.js:265 / briefAgent.js:17-18)
SLACK_PNL_CHANNEL=C0AF724MJPR
SLACK_KPI_CHANNEL=C0AN0BPN0NA
# SLACK_REJECTION_CHANNEL was already env on Render — keep the value it has there
SLACK_EDITOR_CHANNELS_JSON={"Uly":"C0ANNMMPUCC","Dimaranan":"C0ARP2SBQ8J"}

# Reporting timezone (was reportTz.js:12 / funnelMetrics.js:168 / funnelAttribution.js:224 default)
REPORT_TZ=Europe/Madrid

# Product pipelines (was briefPipeline.js:485-505 CLICKUP_PIPELINES + clickupWebhook.js:30-52 comments/defaults).
# MB is the default (unknown codes → MB, as `pipelineForProduct` always did); PL is reached by code PL
# or DB product_code PUURE; P1 shares PL's list and is routed by its ClickUp Product item.
# The legacy CLICKUP_MB_* / CLICKUP_PUURE_* / FRAMEIO_MB_* / FRAMEIO_PUURE_* keys stay in use by
# clickupWebhook.js for the list-level routing and must keep their current Render values.
PRODUCT_CODES_JSON={"MB":{"default":true,"clickup":{"videoListId":"901518716584","staticListId":"901518769479","mediaBuyingListId":"901518769621","initialStatus":"edit queue"},"frameio":{"projectId":"19c0ce1f-f357-4da8-ba1f-bd7eb201e660","editingFolderId":"2eb1701e-fd39-45fa-a981-947a565f9093","staticEditingFolderId":"c9440b5e-beb0-416a-91bf-27cfb8dad2e9"}},"PL":{"aliases":["PUURE"],"namingCode":"PL","fbPage":"Puure","clickup":{"videoListId":"901524484514","initialStatus":"edit queue"},"frameio":{"projectId":"b38fbf28-9004-422d-902b-8cb4abed214b","editingFolderId":"51ec2ac5-4e55-4281-bfaa-26776fc81d10"}},"P1":{"namingCode":"P1","clickup":{"videoListId":"901524484514","productId":"123yxuahe91"},"frameio":{"projectId":"b664289d-226b-47c2-a826-5b1377d52b4d","editingFolderId":"10abecc4-31ee-413c-ba12-c7cdddef63cd"}}}
