# server/config/env.PL.example — the NON-SECRET store-config env for the
# Puure dashboard (puure-dashboard). Same keys as env.MB.example; values are
# Puure's own. Where today's code used MINEBLOCK's literal on the Puure deploy
# (Triple Whale shop id, Slack channels, Luvora ad accounts) the key is left
# UNSET here on purpose: unset = that feature dormant with one warning, which
# is the fail-closed behaviour R5/R15 require, never another store's value.
# Secrets are NOT here (FRAMEIO_TOKEN etc. stay on Render). Read at request time (R7).

STORE_CODE=PL

# Brand (the VITE_* values puure-dashboard builds with today)
BRAND_NAME=Puure
BRAND_SHORT_NAME=Puure
BRAND_LOGO_WHITE=/logo-puure-white.png
BRAND_LOGO_SYMBOL=/logo-puure-symbol-white.png
BRAND_LOGO_BLACK=/logo-puure-black.svg
BRAND_EMAIL_DOMAIN=trypuure.co

# Shopify — the Puure store (was reachable only through PUURE_SHOPIFY_STORE shadowing)
SHOPIFY_STORE_DOMAIN=9jn59g-x7.myshopify.com
SHOPIFY_STORE_URL=https://trypuure.co
SHOPIFY_API_VERSION=2024-01

# Whop company id — TODO(lead): Puure's biz_… id is not visible in the repo; unset = dormant
# WHOP_COMPANY_ID=

# Triple Whale — today's code defaulted to MINEBLOCK's shop id here (wrong store). Unset = dormant.
# TRIPLEWHALE_SHOP_ID=

# Meta Graph
META_API_VERSION=v21.0
# Puure's ad accounts: none were ever named in code (only Luvora's, dropped). Empty list = ids display raw.
META_AD_ACCOUNTS_JSON=[]

# Slack — today's code posted Puure's alerts into MINEBLOCK's channels (C0AF724MJPR / C0AN0BPN0NA).
# Unset = skipped with one warning. Set Puure's own channel ids here when they exist.
# SLACK_PNL_CHANNEL=
# SLACK_KPI_CHANNEL=
# SLACK_EDITOR_CHANNELS_JSON=

# Reporting timezone
REPORT_TZ=Europe/Madrid

# Product pipelines — PL (DB product_code PUURE) and P1 (shares PL's list, routed by its ClickUp
# Product item). No default: an unknown product code is REFUSED with a named error rather than
# pushed to another store's list. The legacy CLICKUP_PUURE_VIDEO_LIST_ID / FRAMEIO_PUURE_* keys
# stay in use by clickupWebhook.js for list-level routing and keep their current Render values.
PRODUCT_CODES_JSON={"PL":{"aliases":["PUURE"],"namingCode":"PL","fbPage":"Puure","clickup":{"videoListId":"901524484514","initialStatus":"edit queue"},"frameio":{"projectId":"b38fbf28-9004-422d-902b-8cb4abed214b","editingFolderId":"51ec2ac5-4e55-4281-bfaa-26776fc81d10"}},"P1":{"namingCode":"P1","clickup":{"videoListId":"901524484514","productId":"123yxuahe91"},"frameio":{"projectId":"b664289d-226b-47c2-a826-5b1377d52b4d","editingFolderId":"10abecc4-31ee-413c-ba12-c7cdddef63cd"}}}
