# server/config/env.SB.example — the env for a store BORN FROM NOTHING.
#
# Same file family as env.MB.example / env.PL.example, but this one answers a
# different question: what is the SMALLEST env that lets this codebase boot on
# an EMPTY database and serve login plus the empty pages of a brand-new store?
# Everything not listed here is deliberately UNSET; each unset key makes exactly
# one feature dormant with one warning, never another store's value (R5/R15).
#
# Proven by execution on 2026-09-10 against a fresh `sb_empty` (111 migrations
# applied, 0 pending, 0 mismatches) — see briefs/out/PROOF-S1-1.md.
#
# SECRETS ARE NOT IN THIS FILE. `<generate>` means the lead generates the value
# on Render (Render's "Generate" button, or `openssl rand -base64 48`) and it
# never lands in git (R20, COMMON.md "no secrets in code or commits").

# ── Required: the store's identity ──────────────────────────────────────────
STORE_CODE=SB

# REQUIRED — the boot gate refuses to start without it (storeConfig.assertBootConfig).
# A brand-new store has no ClickUp lists and no Frame.io project yet, so the
# minimal catalogue is one product code marked default. Verified accepted:
#   assertBootConfig() → {"ok":true,"checked":["PRODUCT_CODES_JSON"]}
PRODUCT_CODES_JSON={"SB":{"default":true}}

# ── Brand (served by GET /api/v1/brand, read at request time) ───────────────
BRAND_NAME=Sandbox
BRAND_SHORT_NAME=Sandbox
BRAND_EMAIL_DOMAIN=sandbox.local
# Logos: unset = the client keeps its build-time fallback. Set them once the
# store has its own asset files under client/public.
# BRAND_LOGO_WHITE=
# BRAND_LOGO_SYMBOL=
# BRAND_LOGO_BLACK=

# ── Core runtime ────────────────────────────────────────────────────────────
NODE_ENV=production
PORT=10000
# Render injects DATABASE_URL from the linked Postgres. Locally:
# DATABASE_URL=postgres://postgres@127.0.0.1:5433/sb_empty
DATABASE_URL=<from the linked Postgres>
# TLS to the database. UNSET = the historical inference (on for NODE_ENV=production
# or a *.render.com host), which is what Render's own Postgres wants, so LEAVE IT
# UNSET ON RENDER. Set DATABASE_SSL=0 only where the database does not terminate
# TLS (the local sandbox this store is proven on); before this knob existed a
# production-env boot against such a database gave /api/health 503 and login 500.
# DATABASE_SSL=0
CORS_ORIGIN=https://sb-dashboard.onrender.com
REPORT_TZ=Europe/Madrid
LOG_LEVEL=info

# ── Auth secrets — GENERATE, at least 32 bytes, never the repo dev value ────
# The dev defaults ('dev-access-secret-change-me' / 'dev-refresh-secret-change-me')
# only warn in production; they are a live-token forgery, so they are refused here.
JWT_ACCESS_SECRET=<generate>
JWT_REFRESH_SECRET=<generate>
# JWT_SECRET is read by ONE thing: the AES key that encrypts stored gateway
# credentials (services/gatewayConfigs.js credsKey(), which falls back to
# JWT_ACCESS_SECRET). Set it now so a later rotation of JWT_ACCESS_SECRET does
# not make already-stored gateway secrets undecryptable.
JWT_SECRET=<generate>

# ── First administrator — per-store credentials (R4), no default anywhere ────
# The boot seed (server.js runSeeds) and `npm run seed` both REFUSE without
# these. `must_change_password` is set on the created user.
SUPERADMIN_EMAIL=<the store's own admin address>
SUPERADMIN_PASSWORD=<generate>

# ── Meta Graph ──────────────────────────────────────────────────────────────
# One version for every call site. No token yet ⇒ every Meta call is dormant.
META_API_VERSION=v23.0
# No ad accounts yet. Empty list = ids display raw, no other store's names.
META_AD_ACCOUNTS_JSON=[]

# ── Shopify ─────────────────────────────────────────────────────────────────
# PLACEHOLDER-FREE ON PURPOSE. Measured on this tree: with SHOPIFY_STORE_DOMAIN
# unset the server BOOTS, serves /api/health, the login POST, /api/v1/brand,
# /api/v1/store-config, GET /api/v1/orders and the creative routes; only the
# Shopify Admin calls are dormant (one warning:
#   [storeConfig] SHOPIFY_STORE_DOMAIN: not set — Shopify Admin calls are dormant).
# So NO placeholder is needed and none should be invented: a fake myshopify
# domain would make the KPI route call a domain the store does not own.
# Set both, with the store's real values, when the storefront exists:
# SHOPIFY_STORE_DOMAIN=
# SHOPIFY_STORE_URL=
# SHOPIFY_API_VERSION=2024-01   (default when unset)

# ── Everything below stays UNSET on a newborn store ─────────────────────────
# Each line names the panel that goes dormant. Unset = dormant + one warning.
#   META_ACCESS_TOKEN / META_WEBHOOK_VERIFY_TOKEN  → ad launcher, ads control
#                                                     centre, rejection monitor,
#                                                     Meta webhooks
#   CLICKUP_API_TOKEN                               → brief pipeline, ClickUp
#                                                     webhook routing
#   FRAMEIO_TOKEN                                   → editor delivery, Frame.io
#                                                     folders
#   SLACK_BOT_TOKEN / SLACK_PNL_CHANNEL /
#     SLACK_KPI_CHANNEL / SLACK_REJECTION_CHANNEL /
#     SLACK_EDITOR_CHANNELS_JSON                    → all Slack alerting
#   TRIPLEWHALE_API_KEY / TRIPLEWHALE_SHOP_ID       → Triple Whale analytics
#   WHOP_API_TOKEN / WHOP_COMPANY_ID                → Whop subscriptions / KPI
#   SHOPIFY_ACCESS_TOKEN / SHOPIFY_WEBHOOK_SECRET   → order sync, storefront
#   ANTHROPIC_API_KEY / GEMINI_API_KEY /
#     NANOBANANA_API_KEY / OPENAI_API_KEY           → statics + brief generation
#   R2_* / CLOUDFLARE_*                             → media upload / previews,
#                                                     Brain raw-body archive (see above)
#   REDIS_URL                                       → cache; boot logs one
#                                                     "Continuing without Redis"
#   CHECKOUT_CREDS_KEY                              → optional; falls back to
#                                                     JWT_SECRET for gateway creds
#   SUPPLIER_SHARE_TOKEN                            → supplier share links
#
# ── The Store Brain (S4-SB) ─────────────────────────────────────────────────
# The per-pair service token the CRM / pipelines present as X-Brain-Service-Token.
# READ-ONLY by construction: search, documents, insights and the playbook may be
# READ with it; approving an insight, writing or locking the playbook, ingesting
# and extracting all need a dashboard session with brain:write / brain:approve.
# Per store (R4/R39), no platform fallback, minimum 16 characters. Unset ⇒ every
# service call answers 503, never "allow", and the dashboard session path is
# unaffected.
BRAIN_SERVICE_TOKEN=<generate>
# Migration 131 gives every role that already had `brain` the read + write
# actions. `brain:approve` is granted to NO role by default — SuperAdmin has it
# through {"*":["*"]}; name any other reviewing role deliberately (see 131).

# ── Cloudflare R2 — media AND the Brain's raw-body archive ──────────────────
# All five are read at REQUEST time. R2_BUCKET_NAME is REQUIRED before the Brain
# will mirror anything: account + keys with no bucket falls back to a bucket name
# shared by every store, and a body's key is its sha256, so identical bytes in two
# stores are the SAME key and the second ingest overwrites the first store's
# archive. With it set, keys are prefixed stores/<STORE_CODE>/knowledge/raw/…, so
# even a shared bucket cannot collide. STORE_CODE unset ⇒ no mirror at all.
# Unset here = the Brain keeps every body in Postgres (search is unaffected) and
# logs one line per ingest saying it did not mirror, and why.
# R2_ACCOUNT_ID=
# R2_ACCESS_KEY_ID=
# R2_SECRET_ACCESS_KEY=
# R2_BUCKET_NAME=
# R2_PUBLIC_URL=

# ── Hub SSO (S1-4) — dark until the hub issues this store's secret ──────────
HUB_SSO_ENABLED=0
# HUB_SSO_SECRET=<generate, ≥32 bytes, issued per store by the hub>
# HUB_ORIGIN=
#
# ── Migrations ──────────────────────────────────────────────────────────────
# Pre-deploy command runs `npm run migrate` (needs STORE_CODE, set above).
# Turn STRICT on only AFTER the first successful migrate on this database.
# STRICT_MIGRATIONS=1

# ── Video launcher (W9 / R20) — OPTIONAL, per store ─────────────────────────
# This store's own video-launcher tool, embedded by the ClickUp Pipeline page.
# Both keys are read at request time (R7). Unset = the page renders a disabled
# panel saying the launcher is not configured for this store; nothing is called
# and nothing errors. There is no cross-store fallback and there must never be
# one: another store's launcher is another store's credential (R4 / R5).
# VIDEO_LAUNCHER_TOKEN is WRITE-ONLY (R20) — never returned to the client,
# never logged, reported only as `token_set`.
# VIDEO_LAUNCHER_URL=
# VIDEO_LAUNCHER_TOKEN=
